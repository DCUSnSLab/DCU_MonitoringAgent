# backend 작업 디렉터리에서 실행. 실제 .env는 Git에서 제외됨.
DATABASE_URL=sqlite+aiosqlite:///./dcu_monitoring.db
DASHBOARD_AUTH_MODE=sso
DASHBOARD_FRONTEND_URL=http://localhost:3000
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_TOKEN_TTL_HOURS=12
CORS_ORIGINS=["http://localhost:3000"]
SSO_ISSUER=https://code.cu.ac.kr/sso
SSO_INTERNAL_BASE=
SSO_CLIENT_ID=agent-monitoring
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/api/auth/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSO_TOKEN_ENCRYPTION_KEY=
