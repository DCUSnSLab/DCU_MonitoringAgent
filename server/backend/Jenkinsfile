def app

node {
    stage('Checkout') {
        checkout scm
    }

    stage('Ready') {
        sh "echo 'Ready to build Backend'"
    }

    stage('Build image') {
        // 서버 백엔드 폴더(서브 디렉토리)에서 Docker 빌드
        dir('server/backend') {
            app = docker.build("harbor.cu.ac.kr/dcuclassagent/backend")
        }
    }

    stage('Push image') {
        // Harbor 인증 정보가 설정된 Credentials ID (jenkins 설정 확인 필요)
        // 기존 파일에 기재된 것처럼 "harbor" 라는 ID를 사용한다고 가정했습니다.
        docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
            app.push("latest")
            app.push("${env.BUILD_NUMBER}")
        }
    }

    stage('Kubernetes deploy') {
        // 전체 k8s 매니페스트 적용 (존재하지 않으면 생성, 변경시 적용)
        sh "kubectl apply -f /services/dcuclassagent/k8s-manifest.yaml"
        // latest 태그 사용 시 파드가 새 이미지를 당겨오도록 강제 재시작 (rollout)
        sh "kubectl rollout restart deployment backend -n dcu-agent-monitor"
    }

    stage('Complete') {
        sh "echo 'Backend deployment completed successfully!'"
    }
}
