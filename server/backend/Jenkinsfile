// 백엔드 빌드·배포 파이프라인
//
// 브랜치별 동작 (aibootcamp 와 같은 develop/main 운영):
// - main    : 테스트 → 이미지 빌드 → Harbor 푸시(latest, 빌드번호) → 운영(dcu-agent-monitor) 배포
// - develop : 테스트 → 이미지 빌드 → Harbor 푸시(develop) → develop 환경(dcu-agent-monitor-dev, NodePort 30086) 배포
// Jenkins 잡의 브랜치 지정자에 main 과 develop 을 모두 넣어야 한다.
def app
def isMain = false

node {
    stage('Checkout') {
        def scmVars = checkout scm
        def branch = env.BRANCH_NAME ?: (scmVars.GIT_BRANCH ?: '')
        isMain = (branch == 'main' || branch.endsWith('/main'))
        echo "branch=${branch} → ${isMain ? '운영 배포 (main)' : 'develop 환경 배포'}"
    }

    stage('Test') {
        // 서버 테스트를 일회용 파이썬 컨테이너에서 실행 (Jenkins 호스트에 파이썬 불필요, 운영 이미지와 같은 버전)
        docker.image('python:3.11.16-slim').inside('-e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 -e PYTHONPATH=/tmp/deps') {
            dir('server/backend') {
                sh 'pip install -q --root-user-action=ignore --target /tmp/deps -r requirements-dev.txt'
                sh 'python -m pytest -q -p no:cacheprovider tests'
            }
        }
    }

    stage('Build image') {
        // 서버 백엔드 폴더(서브 디렉토리)에서 Docker 빌드
        dir('server/backend') {
            app = docker.build("harbor.cu.ac.kr/dcuclassagent/backend")
        }
    }

    if (isMain) {
        stage('Push image') {
            // Harbor 인증 정보가 설정된 Credentials ID ("harbor")
            docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
                app.push("latest")
                app.push("${env.BUILD_NUMBER}")
            }
        }

        stage('Kubernetes deploy') {
            // 전체 k8s 매니페스트 적용 (존재하지 않으면 생성, 변경시 적용)
            sh "kubectl apply -f /services/dcuclassagent/k8s-manifest.yaml"
            // latest 태그 사용 시 파드가 새 이미지를 당겨오도록 강제 재시작 (rollout)
            sh "kubectl rollout restart deployment backend -n dcu-agent-monitor"
        }

        stage('Complete') {
            sh "echo 'Backend deployment completed successfully!'"
        }
    } else {
        stage('Push image (develop)') {
            // develop 태그만 올린다 (latest 를 건드리지 않으므로 운영 파드가 재시작돼도 영향 없음)
            docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
                app.push("develop")
                app.push("develop-${env.BUILD_NUMBER}")
            }
        }

        stage('Kubernetes deploy (develop)') {
            // develop 환경은 저장소의 매니페스트가 정본 (운영과 달리 Jenkins 호스트 파일을 쓰지 않음)
            sh "kubectl apply -f server/k8s-manifest-dev.yaml"
            sh "kubectl rollout restart deployment backend -n dcu-agent-monitor-dev"
            sh "kubectl rollout status deployment backend -n dcu-agent-monitor-dev --timeout=180s"
        }

        stage('Complete') {
            echo "develop 배포 완료 — 백엔드 http://203.250.35.27:30086 (운영에는 영향 없음)"
        }
    }
}
