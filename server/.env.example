DATABASE_URL=postgresql+asyncpg://dcu:dcu1234@db:5432/dcu_monitoring
API_KEY=dcu-secret-key-change-in-production
# 대시보드 관리자 로그인 (비밀번호가 비어 있으면 로그인 불가). 운영은 K8s Secret dcu-dashboard-auth 로 넣는다
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=
# 로그인 토큰 서명값 (비어 있으면 서버 재시작마다 다시 로그인 필요). 예: openssl rand -hex 32
DASHBOARD_TOKEN_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
REPORT_RETENTION_DAYS=7
