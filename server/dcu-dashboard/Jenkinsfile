// 프론트엔드(대시보드) 빌드·배포 파이프라인
//
// 브랜치별 동작 (aibootcamp 와 같은 develop/main 운영):
// - main    : 이미지 빌드(운영 백엔드 주소) → Harbor 푸시(latest, 빌드번호) → 운영(dcu-agent-monitor) 배포
// - develop : 이미지 빌드(develop 백엔드 주소 30086) → Harbor 푸시(develop) → develop 환경(dcu-agent-monitor-dev, NodePort 30031) 배포
// NEXT_PUBLIC_* 는 빌드 시점에 번들에 들어가므로 환경마다 따로 빌드한다. next build 가 타입 검사까지 수행한다.
// Jenkins 잡의 브랜치 지정자에 main 과 develop 을 모두 넣어야 한다.
def app
def isMain = false

node {
    stage('Checkout') {
        def scmVars = checkout scm
        def branch = env.BRANCH_NAME ?: (scmVars.GIT_BRANCH ?: '')
        isMain = (branch == 'main' || branch.endsWith('/main'))
        echo "branch=${branch} → ${isMain ? '운영 배포 (main)' : 'develop 환경 배포'}"
    }

    stage('Build image') {
        def apiUrl = isMain ? 'http://203.250.35.27:30085' : 'http://203.250.35.27:30086'
        def wsUrl = isMain ? 'ws://203.250.35.27:30085' : 'ws://203.250.35.27:30086'
        // 프론트엔드 폴더(서브 디렉토리)에서 Docker 빌드
        dir('server/dcu-dashboard') {
            app = docker.build("harbor.cu.ac.kr/dcuclassagent/frontend", "--build-arg NEXT_PUBLIC_API_URL=${apiUrl} --build-arg NEXT_PUBLIC_WS_URL=${wsUrl} .")
        }
    }

    if (isMain) {
        stage('Push image') {
            docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
                app.push("latest")
                app.push("${env.BUILD_NUMBER}")
            }
        }

        stage('Kubernetes deploy') {
            sh "kubectl apply -f /services/dcuclassagent/k8s-manifest.yaml"
            // 최신 프론트엔드 이미지 반영을 위해 파드 재구동
            sh "kubectl rollout restart deployment frontend -n dcu-agent-monitor"
        }

        stage('Complete') {
            sh "echo 'Frontend deployment completed successfully!'"
        }
    } else {
        stage('Push image (develop)') {
            docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
                app.push("develop")
                app.push("develop-${env.BUILD_NUMBER}")
            }
        }

        stage('Kubernetes deploy (develop)') {
            sh "kubectl apply -f server/k8s-manifest-dev.yaml"
            sh "kubectl rollout restart deployment frontend -n dcu-agent-monitor-dev"
            sh "kubectl rollout status deployment frontend -n dcu-agent-monitor-dev --timeout=180s"
        }

        stage('Complete') {
            echo "develop 배포 완료 — 대시보드 http://203.250.33.67:30031 (운영에는 영향 없음)"
        }
    }
}
