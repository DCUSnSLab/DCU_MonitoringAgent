// 프론트엔드(대시보드) 빌드·배포 파이프라인
//
// 브랜치별 동작 (aibootcamp 와 같은 develop/main 운영):
// - main    : 이미지 빌드(next build 로 타입 검사 포함) → Harbor 푸시(latest, 빌드번호) → 운영 K8s 배포(rollout)
// - develop : 이미지 빌드 → Harbor 푸시(develop 태그만). 운영에는 배포하지 않는다
// Jenkins 잡의 브랜치 지정자에 main 과 develop 을 모두 넣어야 develop 푸시에도 검증이 돈다.
def app
def isMain = false

node {
    stage('Checkout') {
        def scmVars = checkout scm
        def branch = env.BRANCH_NAME ?: (scmVars.GIT_BRANCH ?: '')
        isMain = (branch == 'main' || branch.endsWith('/main'))
        echo "branch=${branch} → ${isMain ? '운영 배포 (main)' : '검증만 — 운영 배포 안 함'}"
    }

    stage('Build image') {
        // 프론트엔드 폴더(서브 디렉토리)에서 Docker 빌드 (next build 가 타입 검사까지 수행)
        dir('server/dcu-dashboard') {
            app = docker.build("harbor.cu.ac.kr/dcuclassagent/frontend", "--build-arg NEXT_PUBLIC_API_URL=http://203.250.35.27:30085 --build-arg NEXT_PUBLIC_WS_URL=ws://203.250.35.27:30085 .")
        }
    }

    if (isMain) {
        stage('Push image') {
            docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
                app.push("latest")
                app.push("${env.BUILD_NUMBER}")
            }
        }

        stage('Kubernetes deploy') {
            sh "kubectl apply -f /services/dcuclassagent/k8s-manifest.yaml"
            // 최신 프론트엔드 이미지 반영을 위해 파드 재구동
            sh "kubectl rollout restart deployment frontend -n dcu-agent-monitor"
        }

        stage('Complete') {
            sh "echo 'Frontend deployment completed successfully!'"
        }
    } else {
        stage('Push image (develop)') {
            // 검증용 태그만 올린다 (latest 를 건드리지 않으므로 운영 파드가 재시작돼도 영향 없음)
            docker.withRegistry("https://harbor.cu.ac.kr", "harbor") {
                app.push("develop")
            }
        }

        stage('Complete') {
            echo "develop 검증 완료 — 이미지 빌드 성공. 운영 배포는 main 에 병합한 뒤 실행됩니다."
        }
    }
}
